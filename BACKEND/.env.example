# === Required ===
DATABASE_URL=postgresql://user:password@host:5432/dbname
GROQ_API_KEY=your_groq_api_key_here

# === TTS (production: Railway microservice) ===
TTS_BACKEND=microservice
TTS_SERVICE_URL=https://your-tts-service.up.railway.app
TTS_LANGUAGE=en
TTS_REQUEST_TIMEOUT=300

# Local dev only (TTS on :8001):
# TTS_SERVICE_URL=http://127.0.0.1:8001

# === Frontend CORS (Vercel) ===
FRONTEND_URL=https://your-app.vercel.app

# === Whisper ===
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SKIP_WHISPER_WARMUP=false

# === Fallback voice (if Railway TTS is down) ===
EDGE_TTS_VOICE=en-US-JennyNeural

LOG_LEVEL=INFO
