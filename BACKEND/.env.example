# === Required (no quotes around the URL) ===
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=128

# TTS on Render: use local Coqui (Python 3.11.9 + runtime.txt)
TTS_BACKEND=coqui
TTS_LANGUAGE=en
TTS_USE_GPU=false
# Local dev with Python 3.12 + microservice (see requirements-core.txt):
# TTS_BACKEND=microservice
# TTS_SERVICE_URL=http://127.0.0.1:8001

# Frontend CORS (Vercel)
FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://app1.vercel.app,https://app2.vercel.app

# Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Edge fallback
EDGE_TTS_VOICE=en-US-JennyNeural

LOG_LEVEL=INFO
SQL_ECHO=false
